{
  "name": "paseo-rooms",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "Paseo Rooms: share a live agent, read-only, with other Paseo users through their own daemons (identity v2).",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "gen:profile": "ELECTRON_RUN_AS_NODE=1 /opt/Paseo/Paseo.bin node_modules/tsx/dist/cli.mjs tools/gen-room-profile.ts",
    "test": "ELECTRON_RUN_AS_NODE=1 /opt/Paseo/Paseo.bin --test --import ./node_modules/tsx/dist/esm/index.mjs test/unit/*.test.ts",
    "test:e2e": "bash test/e2e-v2/run.sh"
  },
  "dependencies": {
    "@getpaseo/protocol": "0.13.2",
    "@getpaseo/relay": "0.13.2",
    "@napi-rs/keyring": "2.1.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "ts-mls": "1.6.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.2",
    "@getpaseo/plugin": "0.13.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/ws": "^8.18.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ts-mls": {
      "@noble/ciphers": "$@noble/ciphers",
      "@noble/curves": "$@noble/curves"
    }
  }
}
