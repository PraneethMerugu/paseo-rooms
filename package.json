{
  "name": "paseo-rooms",
  "private": true,
  "version": "0.2.1",
  "description": "Paseo Rooms: share a live agent, read-only, with other Paseo users through their own daemons.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PraneethMerugu/paseo-rooms.git"
  },
  "homepage": "https://github.com/PraneethMerugu/paseo-rooms#readme",
  "bugs": {
    "url": "https://github.com/PraneethMerugu/paseo-rooms/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:reliability": "tsc -p test/reliability/tsconfig.json",
    "gen:profile": "tsx tools/gen-room-profile.ts",
    "pretest": "node tools/check-node.mjs",
    "test": "node --test --import tsx test/unit/*.test.ts",
    "test:e2e": "bash test/e2e-v2/run.sh",
    "check:docs": "node tools/check-doc-paths.mjs"
  },
  "dependencies": {
    "@getpaseo/protocol": "0.14.0",
    "@getpaseo/relay": "0.14.0",
    "@napi-rs/keyring": "2.1.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "ts-mls": "1.6.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.14.0",
    "@getpaseo/plugin": "0.14.0",
    "@getpaseo/protocol-0.13.2": "npm:@getpaseo/protocol@0.13.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/ws": "^8.18.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ts-mls": {
      "@noble/ciphers": "$@noble/ciphers",
      "@noble/curves": "$@noble/curves"
    }
  }
}
